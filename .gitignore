# Build output
*.obj
*.exe
*.pdb
*.ilk
*.lib
*.exp
*.res
build/
dist/
# Vendored binaries that are part of the tree, not build output
!third_party/webview2/x64/*.lib
!installer/MicrosoftEdgeWebview2Setup.exe
# installer/media/ stays committed: CI cannot regenerate it (see installer/README.md)

# Editor / OS
.vs/
*.user
Thumbs.db

# Claude Code: machine-specific settings, worktrees, plans and brainstorm output
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
.superpowers/
docs/superpowers/

# Runtime and diagnostic output (a dev build keeps its ini, profiles and logs next to the exe)
/magnifier.ini
/profiles/
/logs/
/mpo_boot.txt
/churny_apps.txt
*.log
*.csv
*.dmp
*.WebView2/
wind_selftest.png
wind_hdr_diag.txt
render_smoke*
build_*.txt

# Test harness
tools/testenv/results/
tools/testenv/gamesim.exe
tools/testenv/*.obj

# Local SDKs and models for upscaler experiments (proto/upscalers): never committed (NVIDIA licence, size)
.deps/
